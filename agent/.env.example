# Agent 环境变量示例（复制为 .env 使用；.env 已被 gitignore 忽略，不要提交）
# 提示：WebUI 配置页提供预设模板（默认/安静/活跃/夜间静默/经典）与「恢复默认」；
#       只改触发/节律/近期状态相关项，写入前自动备份 .env.bak.<ts>，重启后生效。
# ════════════════════════════════════════════════════════════════════════════
# 模型接入系统（多 Provider 注册表，参考 AstrBot）
# ════════════════════════════════════════════════════════════════════════════
# 多模型/多供应商请写在 <data>/providers.json（见 providers.example.json）：
#   { "active": "id", "providers": [{ id,name,type,baseUrl,apiKey,model,pricePerMIn,pricePerMOut,fallback,enabled }] }
#   - apiKey 支持 "$ENV_VAR" 引用（不落明文密钥）
#   - 运行时热切换（/api/models/switch），无需重启
#   - fallback: 当前模型失败时按数组顺序自动降级
# 下面的单套 LLM_* 仅作兜底/默认 provider（providers.json 不存在时用）。

# LLM API（必填，全配置驱动，不写死任何路径/URL）
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_MODEL=agnes-2.5-flash
LLM_API_KEY=your-llm-api-key
# LLM_MAX_TOKENS=2048       # 单次生成上限 token（默认 2048，越大回复越能写）

# 计费（元/百万token；默认 0 不计量。填了才会在统计里算钱）
# LLM_PRICE_PER_M_IN=0.5
# LLM_PRICE_PER_M_OUT=2
# EMBED_PRICE_PER_CALL=0

# RAG（可选；不配置则不检索）
RAG_DB_PATH=/absolute/path/to/qwen_persona_rag.sqlite
# Embedding（真向量检索用，OpenAI 兼容 /v1/embeddings）
EMBED_ENDPOINT=https://api.futureppo.top/v1/embeddings
EMBED_MODEL=qwen3-embedding-0.6b
EMBED_API_KEY=请填入你的embed key
# sqlite-vec 扩展（vec0 虚拟表），缺省可退化为 FTS5/LIKE
VEC0_SO=/absolute/path/to/vec0.so
RAG_TOP_K=3
# 混合检索：一般只走本地 FTS/LIKE（零成本），命中此概率才调远程 embed 走向量（0=纯本地；1=每次都向量）
RAG_VEC_PROB=0.3
# 本地检索全空时是否强制升级向量兜底（true=兜底保证有人格参考；false=直接返回空）
RAG_VEC_FALLBACK=false
# ── RAG 工具化（function call）──
# 开启后不再每轮把 RAG 当"user 参考资料"注入，改为工具按需调用（search_past_memory / remember）
RAG_TOOLS_ENABLED=true
# 无"过去指代"时的主动回忆概率（0=从不主动，1=每轮都预取）
RAG_RECALL_PROB=0.15
# 工具循环上限（防止小模型反复调用）
RAG_TOOL_MAX_ITER=2
# 每次检索最多注入的记忆条数
RAG_TOOL_MAX_ITEMS=1
# remember 单条事实长度上限
MEMORY_FACT_MAX_CHARS=60

# 攒批 / 冷却 / 记忆（群聊；可选）
# BATCH_N_MIN=3         # 群聊攒批条数随机下限
# BATCH_N_MAX=6         # 群聊攒批条数随机上限（每轮在 [min,max] 随机取目标数）
# BATCH_T=60000         # 攒批窗口基础值（带随机抖动）
# MAX_HISTORY=120       # 喂给 LLM 的即时上下文轮次（每轮=群友消息+回复对），拉长避免前言不搭后语
# REPLY_COOLDOWN=25000

# 私聊独立策略（可选，默认 1 条即回 / 30s 静默 / 10s 冷却）
# PRIVATE_BATCH_N=1
# PRIVATE_BATCH_T=30000
# PRIVATE_REPLY_COOLDOWN=10000

# ═══════════════════════════════════════════════════════════════════
# 拟人画像 HumanProfile（A~E 全维度，全部可配；将来可由原始数据统计覆盖）
# 蓝图见 profile.ts buildProfileFromStats（导入原始库 → 解出作息/频率/风格）
# ═══════════════════════════════════════════════════════════════════
# HL_PROFILE_SOURCE=auto      # env(只用env) | auto(stats.db优先,回退json) | db | json

# ── A. 触发应答：回不回 ──
# GROUP_REPLY_PROB=1.0        # 群聊回复概率 0~1（<1 会随机沉默；被@/唤醒必回）
# PRIVATE_REPLY_PROB=1.0      # 私聊回复概率
# HL_IGNORE_SHORT_MIN_CHARS=0 # 文本短于此长度视为敷衍，可被忽略（0=关闭）
# HL_IGNORE_SHORT_PROB=0      # 命中敷衍短消息后沉默的概率
# ── 反模板/反复读（防止一个词锁死，如"剑魔"75%）──
# HL_ANTIREPEAT=true                 # 总开关
# HL_ANTIREPEAT_WINDOW=20            # 统计最近多少条自己的回复
# HL_ANTIREPEAT_MIN_COUNT=3          # 过热词最小出现次数
# HL_ANTIREPEAT_RATIO=0.25           # 过热词占比阈值（出现条数/窗口）
# HL_ANTIREPEAT_SIM_THRESHOLD=0.85   # 与近期回复相似度超过则跳过（近重复）
# HL_ANTIREPEAT_MAX_HINT=6           # 提示里最多列几个过热词
# ── 对话状态（距上次本人发言越久越可能不回；被@/唤醒不受限）──
# HL_STATE_ENABLED=true       # 开启对话状态模型
# HL_STATE_PRIVATE=false      # 是否也作用于私聊
# HL_STATE_ACTIVE_WITHIN_MS=60000   # <1min 视为热聊
# HL_STATE_ACTIVE_PROB=1.0
# HL_STATE_SEMI_WITHIN_MS=300000    # <5min 半热
# HL_STATE_SEMI_PROB=0.9
# HL_STATE_COLD_WITHIN_MS=1800000   # <30min 冷场
# HL_STATE_COLD_PROB=0.85
# HL_STATE_VERY_COLD_PROB=0.8       # >30min 冷启动
# HL_REPLY_HOURLY=            # 24 个分时段乘数，逗号分隔（空=不启用）
# HL_BATCH_PENALTY_FROM=10    # 对方一次连发≥N条时打折
# HL_BATCH_PENALTY_FACTOR=0.85

# ── B. 反应与节奏：多久回 ──
# REPLY_REACT_MIN_MS=2500     # 触发后的随机反应/思考延迟下限(ms)，绝不秒回
# REPLY_REACT_MAX_MS=8000     # 反应延迟上限(ms)
# HL_REACT_DIST=2000:28,3000:16,5000:22,10000:19,30000:10,60000:2,300000:3  # 经验延迟分布(上限ms:权重)
# REPLY_COOLDOWN=25000        # 群聊两次回复最小间隔(ms)（基础值，实际带随机抖动）
# PRIVATE_REPLY_COOLDOWN=10000# 私聊两次回复最小间隔(ms)（基础值，实际带随机抖动）
# HL_JITTER_RATIO=0.35        # 冷却/防抖/首条迟疑的抖动比(±ratio)，破坏固定节奏防封控
# HL_BURST_MAX=3              # 刷屏抑制：窗口内最多回几次
# HL_BURST_WINDOW_MS=180000   # 刷屏统计窗口(ms)
# HL_BURST_EXTRA_COOLDOWN_MS=60000  # 超限后额外冷却(ms)

# ── C. 打字节奏：怎么发 ──
# SEGMENT_ON_NEWLINE=true     # 回复按换行拆成多条发送（默认开）
# HL_TYPING_CPS_MIN=3         # 打字速度下限（字/秒）
# HL_TYPING_CPS_MAX=9         # 打字速度上限（字/秒）
# SEGMENT_GAP_MIN_MS=900      # 条间停顿下限(ms)（不含打字时间）
# SEGMENT_GAP_MAX_MS=3200     # 条间停顿上限(ms)
# HL_MAX_SEGMENTS=6           # 一次最多拆几条（超出合并）
# SEGMENT_FIRST_DELAY_MS=500  # 第一条发出前的短暂迟疑
# SEGMENT_KEEP_BLANK=false    # 空行是否也单独成条（默认跳过）

# ── D. 话术风格：说成什么样 ──
# HL_STYLE_MAX_CHARS=120      # 回复超长自动收敛（防小作文），句子边界截断
# HL_MAX_SEGMENT_CHARS=0      # 单条消息字数上限（0=关；超长在标点处再拆）
# HL_STYLE_EMOJI_PROB=0.15    # 句尾偶发表情概率
# HL_STYLE_EMOJIS=😂,😅,🤔      # 表情池
# HL_STYLE_FILLER_PROB=0.2    # 开头偶发语气词概率
# HL_STYLE_FILLERS=emm,啊这,…… # 语气词池
# HL_STYLE_TYPO_PROB=0.03     # 偶尔错别字概率
# HL_STYLE_TYPOS=在=再,吗=嘛   # 错别字映射（对词=错词）
# HL_STYLE_ECHO_PROB=0.08     # 偶尔回敬对方关键词概率
# ── 脏话处理：建议用 system prompt 诱导（"脏字当调味料"），不搞硬替换 ──
# PERSONA_SYSTEM_PROMPT=...    # 群里说话分寸写在这里，让 LLM 自己把握
# PERSONA_PRIVATE_SYSTEM_PROMPT=... # 私聊同理

# ── E. 日程节律：什么时候活 ──
# QUIET_HOURS=                # 完全静默时段，如 00:30-08:00（空=关闭）
# HL_DROWSY=                  # 半醒时段 start-end@静默概率，如 23:00-00:30@0.5
# PROACTIVE_GAP_MS=0          # 场景沉寂多久后主动冒泡（0=关闭）

# ── E2. 近期状态模型（精力/心情/耐心/社交/忙碌/烦躁…，全局单例）──
# 事件驱动 + 指数衰减回基线；状态行放对话尾部注入，不破坏 system 前缀缓存。
# ⚠ 注意：状态系统会注入"累就短/烦就敷衍/不想聊就嗯哦"等诱导，过度使用会让模型
#   整体变敷衍/复读"困死了/睡了/别烦我"。2026-10-27 起默认关闭（HL_STATE_MODEL=false）。
# HL_STATE_MODEL=false                # 总开关（'true' 才开启）
# HL_STATE_INJECT=false               # 是否把状态行注入 LLM（'true' 才注入）
# HL_STATE_PROMPT_MAX_CHARS=260       # 状态行最大长度（超出截断）
# HL_STATE_NOISE=0.02                 # 每次事件随机扰动
# HL_STATE_WINDOW_MS=300000           # 近期消息/回复衰减半衰期
# HL_STATE_STREAK_TIMEOUT_MS=600000   # 连发计数重置间隔
# HL_STATE_ENERGY_HOURLY=             # 24 个精力基线（空=画像/默认曲线）
# HL_STATE_BUSY_HOURS=09:00-12:00@0.55,14:00-18:00@0.55  # 忙碌时段
# 基线（0~1）
# HL_STATE_BASE_ENERGY=0.6
# HL_STATE_BASE_MOOD=0.55
# HL_STATE_BASE_PATIENCE=0.7
# HL_STATE_BASE_SOCIAL=0.8
# HL_STATE_BASE_BUSY=0.15
# 衰减半衰期（ms，越小回基线越快）
# HL_STATE_DECAY_ENERGY_MS=2700000
# HL_STATE_DECAY_MOOD_MS=5400000
# HL_STATE_DECAY_PATIENCE_MS=2400000
# HL_STATE_DECAY_SOCIAL_MS=3600000
# HL_STATE_DECAY_BUSY_MS=1200000
# HL_STATE_DECAY_IRRITATION_MS=480000
# HL_STATE_DECAY_INTEREST_MS=1200000
# HL_STATE_DECAY_FOCUS_MS=1800000
# HL_STATE_DECAY_TOPIC_MS=1200000
# 效果开关（false=该维度不受状态影响）
# HL_STATE_EFFECT_REPLY=true
# HL_STATE_EFFECT_REACT=true
# HL_STATE_EFFECT_STYLE=true
# HL_STATE_EFFECT_PROACTIVE=true
# 效果强度（1=默认，0=关闭该维度）
# HL_STATE_W_REPLY=1
# HL_STATE_W_REACT=1
# HL_STATE_W_LENGTH=1
# HL_STATE_W_EMOJI=1
# HL_STATE_W_FILLER=1
# HL_STATE_W_TYPO=1
# HL_STATE_W_ECHO=1
# HL_STATE_W_PROACTIVE=1

# 白/黑名单 / 应答模式
# ALLOW_SCENES=               # 白名单 g:群号,p:QQ号 逗号分隔（空=全部）
# DENY_SCENES=                # 黑名单
# RESPOND_MODE=auto           # auto | mention

# 上下文记忆 / 长期记忆（参考 AstrBot ContextManager）
# MEMORY_PERSIST=true                 # 持久化对话到 sqlite，重启不丢（默认开）
# MEMORY_MAX_TOKENS=65536            # 上下文上限 token，超阈值触发 LLM 摘要压缩（0=关闭）
# MEMORY_COMPRESS_THRESHOLD=0.82      # 占用超 maxTokens*此比例 触发压缩
# MEMORY_KEEP_RECENT_RATIO=0.15       # 压缩时保留最近对话的比例（老的进摘要）
# MEMORY_SUMMARY_MERGING=true         # 每次摘要合并进长期记忆

# Persona（可选）
PERSONA_NAME=崽种
PERSONA_FRIEND=朋友
# 群里被这些词叫会唤醒（逗号分隔）
# PERSONA_WAKE_WORDS=崽种,qq,机器人
# 私聊专用 system prompt（不配用通用模板）
# PERSONA_PRIVATE_SYSTEM_PROMPT=

# WebUI（可选，默认 127.0.0.1:8085）
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8085

# NapCat（可选，默认 127.0.0.1:3001）
# NAPCAT_HOST=127.0.0.1
# NAPCAT_PORT=3001
